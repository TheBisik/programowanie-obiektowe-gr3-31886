@page
@model IndexModel
@{
    ViewData["Title"] = "Główna";
}

<div class="bg-white min-h-screen">


    <main class="max-w-4xl mx-auto pt-24 px-6 text-center">
        <h1 class="text-5xl font-extrabold text-gray-900 tracking-tight mb-6">
            Zarządzaj swoimi kodami <span class="text-indigo-600">błyskawicznie.</span>
        </h1>
        <p class="text-lg text-gray-500 mb-10 leading-relaxed">
            Prosty, intuicyjny system do generowania, przechowywania i weryfikacji kodów rabatowych dla Twojego biznesu.
        </p>
        <div class="flex justify-center gap-4">
            <a href="/Management" class="px-8 py-3 bg-gray-900 text-white font-medium rounded-xl hover:bg-black transition shadow-lg shadow-gray-200">Dodaj nowy kod</a>
            <a href="/Codes" class="px-8 py-3 bg-white border border-gray-200 text-gray-700 font-medium rounded-xl hover:bg-gray-50 transition">Przeglądaj bazę</a>
        </div>
    </main>
</div>
