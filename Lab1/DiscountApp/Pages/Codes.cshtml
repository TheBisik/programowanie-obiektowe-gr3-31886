@page
@model CodesModel
@{
    ViewData["Title"] = "Lista";
}
<div class="max-w-6xl mx-auto py-12 px-6">
    <div class="flex justify-between items-end mb-8">
        <div>
            <h1 class="text-3xl font-bold text-gray-900">Wszystkie kody</h1>
            <p class="text-gray-500 mt-1">Pełna lista wygenerowanych kodów w systemie.</p>
        </div>
        <a href="/Management" class="text-sm font-semibold text-indigo-600 hover:text-indigo-700">+ Dodaj nowy</a>
    </div>

    <div class="bg-white border border-gray-200 rounded-2xl overflow-hidden shadow-sm">
        <table class="w-full text-left border-collapse">
            <thead>
            <tr class="bg-gray-50 border-b border-gray-200 text-xs uppercase tracking-wider text-gray-500 font-semibold">
                <th class="px-6 py-4">ID</th>
                <th class="px-6 py-4">Kod</th>
                <th class="px-6 py-4">Status</th>
                <th class="px-6 py-4">Opis</th>
            </tr>
            </thead>
            <tbody class="divide-y divide-gray-100 text-sm text-gray-700">
            @foreach (var item in Model.AllCodes) {
                <tr class="hover:bg-gray-50 transition">
                    <td class="px-6 py-4 font-mono text-gray-400">#@item.Id</td>
                    <td class="px-6 py-4 font-bold text-gray-900">@item.Code</td>
                    <td class="px-6 py-4">
                        <span class="px-2.5 py-0.5 rounded-full text-xs font-medium 
        @(item.Status.ToString().ToUpper() == "ACTIVE" ? "bg-green-100 text-green-700" : "bg-gray-100 text-gray-600")">
                            @item.Status
                        </span>
                    </td>
                    <td class="px-6 py-4 text-gray-500">@item.Description</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>